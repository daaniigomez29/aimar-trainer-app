# Supabase
.branches
.temp

# Consultas que Supabase Studio guarda solas al usar su editor SQL. Son
# pruebas contra local o produccion y no forman parte del proyecto: si una
# hace falta, se pasa a una migracion o a un script a proposito.
snippets/

# dotenvx
.env.keys
.env.local
.env.*.local

# Secretos de las Edge Functions en local (RESEND_API_KEY, etc.). `.env.local` ya
# estaba cubierto, pero `supabase/functions/.env` -- la ruta que lee
# `supabase functions serve` por defecto -- no lo estaba.
.env
.env.*
!.env.example
