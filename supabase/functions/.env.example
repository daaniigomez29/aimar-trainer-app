# Copia a supabase/functions/.env (ignorado por git) para desarrollo local.
# `supabase functions serve` lo carga automaticamente.
#
# Aqui van SOLO los secretos propios del proyecto. SUPABASE_URL,
# SUPABASE_ANON_KEY, SUPABASE_PUBLISHABLE_KEYS y SUPABASE_SERVICE_ROLE_KEY NO se
# ponen aqui: las inyecta Supabase automaticamente en el runtime.
#
# En la nube, estos mismos valores se cargan con:
#   supabase secrets set --env-file supabase/functions/.env

# Con RESEND_API_KEY sin rellenar, las invitaciones se entregan en Mailpit (el
# buzon de pruebas de `supabase start`, en http://127.0.0.1:54324) y el flujo se
# puede probar completo sin dominio verificado. El nombre de host es el del
# contenedor, porque ambos comparten la red de Docker.
CORREO_DEV_URL=http://supabase_inbucket_aimar_trainer_app:8025

# APP_BASE_URL es el destino del enlace de invitacion: debe coincidir con el
# puerto en el que corre la app y con `site_url` de supabase/config.toml.
APP_BASE_URL=http://127.0.0.1:54330

# Para enviar de verdad, rellena estas dos y quita CORREO_DEV_URL.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=no-reply@tudominio.com
