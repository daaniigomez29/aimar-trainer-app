# Copia a supabase/functions/.env (ignorado por git) para desarrollo local.
# `supabase functions serve` lo carga automaticamente.
#
# Aqui van SOLO los secretos propios del proyecto. SUPABASE_URL,
# SUPABASE_ANON_KEY, SUPABASE_PUBLISHABLE_KEYS y SUPABASE_SERVICE_ROLE_KEY NO se
# ponen aqui: las inyecta Supabase automaticamente en el runtime.
#
# En la nube, estos mismos valores se cargan con:
#   supabase secrets set --env-file supabase/functions/.env

# Con RESEND_API_KEY sin rellenar, las invitaciones se entregan en Mailpit (el
# buzon de pruebas de `supabase start`, en http://127.0.0.1:54324) y el flujo se
# puede probar completo sin dominio verificado. El nombre de host es el del
# contenedor, porque ambos comparten la red de Docker.
CORREO_DEV_URL=http://supabase_inbucket_aimar_trainer_app:8025

# APP_BASE_URL hace dos cosas: es el destino del enlace de invitacion (debe
# coincidir con `site_url` de supabase/config.toml) y la lista de origenes a los
# que responden las funciones por CORS.
#
# Admite VARIOS separados por comas, porque la app vive en mas de un sitio. El
# primero es el que se usa para los enlaces de los correos:
#   APP_BASE_URL=https://aimartrainer.com,https://aimar-trainer-app.vercel.app
#
# Si se deja vacio, el CORS responde `*`. Vale para local; en la nube conviene
# listarlos.
APP_BASE_URL=http://127.0.0.1:54330

# Para enviar de verdad, rellena estas dos y quita CORREO_DEV_URL.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=no-reply@tudominio.com

# --- CU-22: recordatorios diarios (fase 6) ---------------------------------
#
# SECRETO_CRON es la cabecera con la que el job de pg_cron se identifica ante la
# funcion. Tiene que coincidir con el secreto `secreto_cron` de Vault (en local lo
# crea supabase/seed.sql; en la nube se crea a mano una vez).
SECRETO_CRON=secreto-local-de-pruebas

# Claves VAPID del push web. Se generan UNA vez por entorno con:
#   deno eval "import w from 'npm:web-push@3.6.7'; console.log(JSON.stringify(w.generateVAPIDKeys()))"
# La publica va tambien en la app (config/dev.json -> VAPID_PUBLIC_KEY): es
# publica a proposito. La privada NO sale de aqui.
VAPID_PUBLIC_KEY=B...
VAPID_PRIVATE_KEY=...
# Contacto obligatorio de VAPID: a donde escribiria el servicio de push si algo
# fuera mal con nuestros envios.
VAPID_SUBJECT=mailto:no-reply@tudominio.com
